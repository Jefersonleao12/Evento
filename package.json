{
  "name": "ont-event-manager",
  "version": "1.0.0",
  "description": "Painel interativo de gestão visual de ONTs para eventos técnicos, com mapa (Leaflet), CRUD de equipamentos e integração com a API do IXC Provedor.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "postinstall": "npm run build:css"
  },
  "keywords": [
    "ixc",
    "ont",
    "isp",
    "mapa",
    "evento",
    "leaflet"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
