# Porta em que o servidor Express irá rodar
PORT=3000

# ------------------------------------------------------------------
# Autenticação do painel
# ------------------------------------------------------------------
# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório
# forte (ex: `openssl rand -hex 32`) e nunca reutilize entre ambientes.
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Usuário/senha do admin criado automaticamente na primeira execução
# (só é usado se a tabela "users" estiver vazia). Depois disso, a senha
# pode ser trocada pela tela de configurações ou diretamente no banco.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# ------------------------------------------------------------------
# Integração com a API do IXC Provedor
# ------------------------------------------------------------------
# URL base do seu IXC (sem barra no final), ex: https://ixc.suaempresa.com.br
IXC_BASE_URL=

# Token gerado em: Configurações Gerais > API > Chaves de acesso
# (usado como usuário e senha em Basic Auth, conforme padrão do IXC)
IXC_TOKEN=

# Alternativa: essas mesmas credenciais podem ser configuradas em tempo
# de execução pela rota POST /api/settings/ixc (ficam salvas no SQLite
# e sobrescrevem estas variáveis de ambiente).

# Intervalo (em milissegundos) entre consultas automáticas do servidor a
# todos os equipamentos com login IXC cadastrado — roda sozinho no backend,
# independente de alguém estar com o painel aberto no navegador. Padrão:
# 60000 (1 minuto). Defina como 0 para desativar a consulta automática.
IXC_AUTO_CHECK_INTERVAL_MS=60000
